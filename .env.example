# API base URL (no trailing slash)
# - iOS Simulator: http://localhost:8080 often works
# - Android Emulator: use http://10.0.2.2:8080 to reach your machine
# - Physical device / Expo Go: use your computer's IP, e.g. http://192.168.1.5:8080
#   (Find IP: Mac/Linux `ifconfig` or `ip addr`, Windows `ipconfig`)
API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
